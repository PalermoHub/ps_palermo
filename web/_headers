# Intestazioni di sicurezza per i file statici (le risposte di /api/* sono in src/index.ts).
# frame-ancestors volutamente assente e niente X-Frame-Options: l'app deve poter stare in un iframe (embed).
# I due sha256 sono i due <script> inline (tema/embed), identici in index, grafici e privacy:
# se si modifica uno di quegli script, ricalcolare l'hash (vedi docs/embed.md) o la pagina parte senza tema.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-EPWqhGqiPOI4GBQ5uHaBuza2vEPxsO4DUFEWvjosRUo=' 'sha256-IAnitVbX4vMnNVkhy7tTdgv+bkmyj/t1+j/ctRTahvI='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org https://tiles.openfreemap.org; connect-src 'self' https://tiles.openfreemap.org https://raw.githubusercontent.com; worker-src blob:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'

/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
